# Copy to .env and fill in. Never commit .env.

# --- LLM provider: openai | gemini | ollama | azure ---
LLM_PROVIDER=gemini
# Optional: override the provider's default model
#   openai: gpt-4.1-mini   gemini: gemini-3.5-flash-lite   ollama: qwen2.5-coder:7b
LLM_MODEL=
# Optional: number to send as temperature (leave empty for models that reject it)
LLM_TEMPERATURE=0
# Optional: max requests per minute (set for free tiers, e.g. 14 for Gemini 3.5 Flash Lite free)
LLM_RPM=

# Keys (only the one for your provider is needed)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ollama needs no key. Azure: also set AZURE_OPENAI_ENDPOINT; LLM_MODEL = deployment name
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: price per 1M tokens for cost reporting (defaults in agent/llm.py)
LLM_PRICE_IN=
LLM_PRICE_OUT=

# --- Database (local dev defaults, match infra/docker-compose.yml) ---
POSTGRES_PORT=5433
ADMIN_DSN=postgresql://postgres:postgres@localhost:5433/analytics
WAREHOUSE_DSN=postgresql://agent_readonly:agent_readonly_dev@localhost:5433/analytics
KNOWLEDGE_DSN=postgresql://knowledge_reader:knowledge_reader_dev@localhost:5433/analytics

# --- Embeddings (local, no key) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
